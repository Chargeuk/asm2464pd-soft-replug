[Unit]
Description=Recover USB enclosure from boot-time USB 2.0 fallback (ASM2464PD MCU reset)
# run after the fstab mount of /mnt/usb2t has been attempted, so the unmount
# inside the script races nothing
After=multi-user.target mnt-usb2t.mount
Wants=mnt-usb2t.mount

[Service]
Type=oneshot
ExecStart=/usr/local/bin/usb-reset.sh
User=root
# script exits 0 when already healthy or absent; nonzero only when the reset
# genuinely failed and a physical replug is needed
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
